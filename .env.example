# Copy this file to `.env` (in the repo root) and fill in your key:
#   cp .env.example .env
#
# The backend reads this file automatically (locally and under Docker Compose).
# Real environment variables always take precedence over values set here.

# ---- Required ----
# Your LLM API key for the /ask assistant.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Server ----
PORT=8000
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# ---- LLM / agent ----
# Model id for the /ask assistant.
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_TOKENS=4096

# ---- Retrieval ----
EMBED_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60

# ---- Corpus framing (re-theme the assistant for your own domain) ----
CORPUS_DOMAIN=genomics
CORPUS_LABEL=7,070 bioRxiv genomics papers

# ---- Data sources (override to point at your own corpus) ----
# Defaults resolve to pipeline/5_INFORMATION_RETRIEVAL/{data,embeddings}.
# For the tiny sample corpus (see `make sample`), use:
#   DATA_DIR=data/sample/data
#   EMBEDDINGS_DIR=data/sample/embeddings
# DATA_DIR=
# EMBEDDINGS_DIR=
# METADATA_PATH=
# CSV_PATH=
# FAISS_PATH=
# ENTITY_CACHE_PATH=

# ---- Frontend (build/runtime) ----
# Where the browser reaches the API. For Docker Compose this is set for you.
VITE_API_URL=http://localhost:8000
